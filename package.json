{
  "name": "game-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "icons:import": "bash scripts/import-icons.sh",
    "gen:sprites": "tsx scripts/gen-sprites.ts",
    "sprites:resize": "for f in public/sprites/*.png; do sips --resampleHeightWidthMax 256 \"$f\" --out \"$f\" >/dev/null; done",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name game-portal --branch main",
    "db:init": "npx --yes wrangler@4 d1 execute game-portal-db --remote --file=schema.sql"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.1.1"
  }
}
